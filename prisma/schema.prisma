// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Clerk's user ID, e.g. "user_2abc..."
  email     String   @unique
  name      String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  risksCreated     Risk[] @relation("CreatedBy")
  risksStateUpdate Risk[] @relation("StateUpdatedBy")

  observationsCreated      Observation[] @relation("ObservationCreatedBy")
  observationsStateUpdated Observation[] @relation("ObservationStateUpdatedBy")

  safetyMeetingsCreated      SafetyMeeting[] @relation("SafetyMeetingCreatedBy")
  safetyMeetingsStateUpdated SafetyMeeting[] @relation("SafetyMeetingStateUpdatedBy")
}

model Risk {
  id      String  @id @default(cuid())
  ref     String  @unique // e.g. "RA-N-040", your human-readable ID
  cloneOf String? // ref of the original if this was cloned

  workActivity     String // Work Activity Being Assessed
  initiator        String // name of person who initiated
  initiationDate   DateTime
  reviewDate       DateTime?
  vesselDepartment String? // e.g. "Company-TMS Tankers Ltd - Office"
  raType           RAType    @default(NON_ROUTINE)
  libraryCategory  String? // e.g. "Navigation"
  libraryIndex     String? // e.g. "NAVIGATION:Navigation in Kiel Canal"
  state            RiskState @default(TEMPLATE)
  notes            String? // any extra notes

  fleet         String? // e.g. "TMS Tankers"
  defectRelated Boolean @default(false)

  alternativeWays     Boolean @default(false)
  alternativeWaysText String?
  emergencyResponse   String? // e.g. "Emergency response plan in place"
  initiatorComment    String?

  // Relations
  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  stateUpdatedById String?
  stateUpdatedBy   User?   @relation("StateUpdatedBy", fields: [stateUpdatedById], references: [id])

  approvedBy String? // "Approved by the office"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentRows RiskAssessmentRow[]
  teamMembers    TeamMember[]

  masterOowDpo         String?
  personInCharge       String?
  authorizedTeamLeader String?
  equipmentOperator    String?
  attendeesWorkTeam    String?

  @@index([ref])
  @@index([state])
  @@index([createdById])
  @@index([fleet])
  @@index([defectRelated])
  @@index([workActivity])
  @@index([initiator])
  @@index([vesselDepartment])
  @@index([raType])
  @@index([libraryIndex])
  @@index([cloneOf])
}

model RiskAssessmentRow {
  id     String @id @default(cuid())
  riskId String
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)

  hazard           String
  impact           String
  existingControls String
  sct              String? // the dropdown value
  c                Int? // consequence 1-6
  f                Int? // frequency 1-6
  rf               Int? // manual 1-25
  rfColor          RFColor? // manual color choice
  order            Int      @default(0)

  responsiblePerson String?

  additionalMeasures AdditionalMeasure[]
}

model AdditionalMeasure {
  id    String            @id @default(cuid())
  rowId String
  row   RiskAssessmentRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  furtherAction String?
  c             Int?
  f             Int?
  rf            Int? // manual 1-25
  rfColor       RFColor? // manual color choice
  order         Int      @default(0)
}

// NOTE: TeamMember (no prefix) is specific to Risk model — kept
// for backward compatibility. All other models use prefixed names
// e.g. SafetyMeetingTeamMember, WorkPermitTeamMember, etc.
model TeamMember {
  id     String @id @default(cuid())
  riskId String
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  name   String
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum RAType {
  ROUTINE
  NON_ROUTINE
}

enum RiskState {
  TEMPLATE
  DRAFT
  COMPLETED
}

enum RFColor {
  GREEN
  YELLOW
  RED
}

enum ObservationState {
  DRAFT
  COMPLETED
}

model Observation {
  id String @id @default(cuid())

  // ─── Auto-generated title — server generates this on create, user never types it ───
  title String

  // ─── Section 1 — Observation Details ─────────────────────────────
  vesselProject   String
  location        String?
  weatherSeaState String?
  date            DateTime
  time            String?
  observerName    String
  createdByField  String? // "Created By" free text field

  // ─── Section 2 — Observation Type (single select) ────────────────
  observationType String?

  // Was Stop Work Authority Used?
  stopWorkUsed Boolean?

  // ─── Section 3 — Observation Source (single select) ──────────────
  observationSource      String?
  observationSourceOther String?

  // ─── Section 4 — Life Saving Rules IOGP (multi select) ────────────
  lifeSavingRules      String[]
  lifeSavingRulesOther String?

  // ─── Section 5 — Risk Priority ────────────────────────────────────
  riskPriority String?
  hiPo         Boolean?

  // ─── Section 6 — Observation Category ─────────────────────────────
  categoryOperations      String[]
  categoryOperationsOther String?

  categorySurveyEquipment      String?
  categorySurveyEquipmentOther String?

  categoryWorkActivities      String[]
  categoryWorkActivitiesOther String?

  categoryHazards      String[]
  categoryHazardsOther String?

  categoryEnvironment      String[]
  categoryEnvironmentOther String?

  // ─── Section 7 — Observation Description ──────────────────────────
  observationDescription String

  // ─── Section 8 — Immediate Action Taken ───────────────────────────
  immediateAction String?

  // ─── Section 9 — Corrective / Preventive Action ───────────────────
  correctiveAction     String?
  correctiveActionDate DateTime?
  preventiveAction     String?
  preventiveActionDate DateTime?
  responsiblePerson    String?

  // ─── Section 10 — Root Cause (multi select) ───────────────────────
  rootCauses     String[]
  rootCauseOther String?

  // ─── Section 11 — Potential Consequence (multi select) ────────────
  potentialConsequences     String[]
  potentialConsequenceOther String?

  // ─── Section 12 — Lessons Learned ──────────────────────────────────
  lessonsLearned    String?
  preventRecurrence String?

  // ─── Section 13 — Close Out (Admin/Manager only) ──────────────────
  closedBy                  String?
  dateClosed                DateTime?
  correctiveActionEffective Boolean?
  furtherActionRequired     Boolean?
  closeOutName              String?

  // ─── Document Footer ────────────────────────────────────────────────
  officeResponse String?
  effectiveDate  DateTime?

  // ─── State ────────────────────────────────────────────────────────
  state ObservationState @default(COMPLETED)

  // ─── Relations ────────────────────────────────────────────────────
  createdById String
  createdBy   User   @relation("ObservationCreatedBy", fields: [createdById], references: [id])

  stateUpdatedById String?
  stateUpdatedBy   User?   @relation("ObservationStateUpdatedBy", fields: [stateUpdatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SafetyMeetingState {
  DRAFT
  COMPLETED
}

model ToolboxTalkCard {
  id         String   @id @default(cuid())
  code       String   @unique
  title      String
  department String? // ← add this
  tags       String[]

  /**
   * Stores the Vercel Blob public URL — not the image itself
   */
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Many-to-many — which SafetyMeetings selected this card
   */
  safetyMeetings SafetyMeetingCard[]
}

model SafetyMeetingCard {
  id              String        @id @default(cuid())
  safetyMeetingId String
  safetyMeeting   SafetyMeeting @relation(fields: [safetyMeetingId], references: [id], onDelete: Cascade)

  cardId String
  card   ToolboxTalkCard @relation(fields: [cardId], references: [id])

  @@unique([safetyMeetingId, cardId])
}

model SafetyMeetingTeamMember {
  id              String        @id @default(cuid())
  name            String
  safetyMeetingId String
  safetyMeeting   SafetyMeeting @relation(fields: [safetyMeetingId], references: [id], onDelete: Cascade)
}

model SafetyMeeting {
  id String @id @default(cuid())

  // ─── Task & Project Information ───────────────────────────────────
  projectSurvey      String
  contractNo         String?
  vesselInstallation String
  date               DateTime
  locationAreaDeck   String
  startTime          String?
  expectedFinish     String?
  activityTask       String
  toolboxTalkLeader  String
  taskObjective      String

  firstTimeNonRoutine Boolean @default(false)
  simopsInvolved      Boolean @default(false)

  // ─── Operational Context (key/value pairs) ────────────────────────
  vesselStatus     String?
  weatherSeaState  String?
  workAreaStatus   String?
  dayNight         String?
  nearbyOperations String?

  // ─── Responsible Interfaces (key/value pairs) ─────────────────────
  masterOowDpo               String?
  deckPic                    String?
  surveyLead                 String?
  equipmentOperator          String?
  responsibleInterfacesOther String?

  // ─── Confirm with the Team ─────────────────────────────────────────
  teamConfirmations      String[]
  teamConfirmationsOther String?

  // ─── State ─────────────────────────────────────────────────────────
  state SafetyMeetingState @default(COMPLETED)

  // ─── Relations ─────────────────────────────────────────────────────
  createdById String
  createdBy   User   @relation("SafetyMeetingCreatedBy", fields: [createdById], references: [id])

  stateUpdatedById String?
  stateUpdatedBy   User?   @relation("SafetyMeetingStateUpdatedBy", fields: [stateUpdatedById], references: [id])

  selectedCards SafetyMeetingCard[]
  teamMembers   SafetyMeetingTeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
