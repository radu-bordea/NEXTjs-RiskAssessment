// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Clerk's user ID, e.g. "user_2abc..."
  email     String   @unique
  name      String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  risksCreated     Risk[] @relation("CreatedBy")
  risksStateUpdate Risk[] @relation("StateUpdatedBy")
}

model Risk {
  id      String  @id @default(cuid())
  ref     String  @unique // e.g. "RA-N-040", your human-readable ID
  cloneOf String? // ref of the original if this was cloned

  workActivity     String // Work Activity Being Assessed
  initiator        String // name of person who initiated
  initiationDate   DateTime
  reviewDate       DateTime?
  vesselDepartment String? // e.g. "Company-TMS Tankers Ltd - Office"
  raType           RAType    @default(NON_ROUTINE)
  libraryCategory   String? // e.g. "Navigation"
  libraryIndex     String? // e.g. "NAVIGATION:Navigation in Kiel Canal"
  state            RiskState @default(TEMPLATE)
  notes            String? // any extra notes

  fleet         String? // e.g. "TMS Tankers"
  defectRelated Boolean @default(false)

  alternativeWays     Boolean @default(false)
  alternativeWaysText String?
  emergencyResponse String? // e.g. "Emergency response plan in place"
  initiatorComment    String?

  // Relations
  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  stateUpdatedById String?
  stateUpdatedBy   User?   @relation("StateUpdatedBy", fields: [stateUpdatedById], references: [id])

  approvedBy String? // "Approved by the office"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentRows RiskAssessmentRow[]
  teamMembers    TeamMember[]
  responsiblePersons    ResponsiblePersons[]

  @@index([ref])
  @@index([state])
  @@index([createdById])
  @@index([fleet])
  @@index([defectRelated])
  @@index([workActivity])
  @@index([initiator])
  @@index([vesselDepartment])
  @@index([raType])
  @@index([libraryIndex])
  @@index([cloneOf])
}

model RiskAssessmentRow {
  id     String @id @default(cuid())
  riskId String
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)

  hazard           String
  impact           String
  existingControls String
  sct              String? // the dropdown value
  c                Int? // consequence 1-6
  f                Int? // frequency 1-6
  rf               Int? // manual 1-25
  rfColor          RFColor? // manual color choice
  order            Int      @default(0)

  additionalMeasures AdditionalMeasure[]
}

model AdditionalMeasure {
  id    String            @id @default(cuid())
  rowId String
  row   RiskAssessmentRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  furtherAction String?
  c             Int?
  f             Int?
  rf            Int? // manual 1-25
  rfColor       RFColor? // manual color choice
  order         Int      @default(0)
}

model TeamMember {
  id     String @id @default(cuid())
  riskId String
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  name   String
}

model ResponsiblePersons {
  id     String @id @default(cuid())
  riskId String
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  name   String
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum RAType {
  ROUTINE
  NON_ROUTINE
}

enum RiskState {
  TEMPLATE
  DRAFT
  COMPLETED
}

enum RFColor {
  GREEN
  YELLOW
  RED
}
